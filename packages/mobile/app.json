{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.sincronia_k7m2.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://sincron-ish7x2g-preview-4200.runable.site/",
      "applicationId": "sincron-ish7x2g",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.sincronia_k7m2.runable",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFFFFF"
    },
    "name": "SINCRONIA",
    "slug": "sincronia",
    "version": "1.0.0",
    "scheme": "runable-sincron-ish7x2g",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font"
    ]
  }
}
